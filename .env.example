OMIE_APP_KEY=your_app_key_here
OMIE_APP_SECRET=your_app_secret_here
# Conector Ecovalor (/mcp) usa OMIE_APP_KEY/OMIE_APP_SECRET acima

# SSO Microsoft Entra ID (app registration "Omie-MCP")
AZURE_TENANT_ID=1a8ae629-1619-4190-a693-3b12e35e3940
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Object ID(s) do grupo com acesso (CSV). Pelo menos um destes dois é obrigatório.
AZURE_ALLOWED_GROUP_IDS=
# Opcional: e-mails liberados além do grupo (CSV)
# AZURE_ALLOWED_EMAILS=

# Conector ESG Now (/esgnow/mcp) — só é ativado se OMIE_APP_KEY_ESGNOW existir
OMIE_APP_KEY_ESGNOW=
OMIE_APP_SECRET_ESGNOW=
# Object ID do grupo "Omie-MCP ESG Now"
AZURE_ALLOWED_GROUP_IDS_ESGNOW=
# AZURE_ALLOWED_EMAILS_ESGNOW=

# Opcional: URL pública fixa (tem que bater com o redirect URI no Entra)
# MCP_PUBLIC_URL=https://omie-mcp-ajcmghftawa4e2fg.brazilsouth-01.azurewebsites.net
# Opcional: segredo dos tokens emitidos (padrão: AZURE_CLIENT_SECRET). Trocar revoga todos.
# MCP_TOKEN_SECRET=
# Opcional: hosts extras permitidos como callback OAuth (CSV)
# MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

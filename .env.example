OMIE_APP_KEY=your_app_key_here
OMIE_APP_SECRET=your_app_secret_here
# Chave que os usuários digitam na tela de vínculo do bridge (/authorize)
MCP_BRIDGE_KEY=omie-mcp-bridge-2026
